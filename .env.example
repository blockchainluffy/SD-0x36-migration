# Copy to .env and adjust.  `source .env` before running, or use `./sim.sh`.

# Ethereum mainnet RPC used for the fork. Any archive-ish node works.
MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com

# Pin the fork block for byte-identical, cacheable reruns. 0 = latest.
FORK_BLOCK=0

# ---------------------------------------------------------------------------
# Attach mode — point the steps at a space that already exists on chain instead
# of having Step 1 create one. Any step can then be run on its own against the
# real deployment. Both must be set together.
#
# Find the strategy with:  ./snapx-strategy.sh from-tx <SPACE_CREATE_TX>
# ---------------------------------------------------------------------------
# SNAPSHOT_X_SPACE=0x...
# SNAPSHOT_X_STRATEGY=0x...

# ---------------------------------------------------------------------------
# Snapshot X space parameters, taken from "SD 0x36_Snapshot X".
# Durations are in BLOCKS (Snapshot X on mainnet uses a blocknumber clock,
# matching SHU's ERC20Votes CLOCK_MODE).
# ---------------------------------------------------------------------------

# The dev wallet that signs "Create" in the snapshot.box UI. This is the ONE input
# to change when you know which wallet you'll actually deploy from: it salts the
# CREATE2 addresses of BOTH the space and the strategy, and it is the space's
# controller until Step 3 hands it to the Security Council. Defaults to a
# deterministic stand-in. (sim.sh: --deployer 0x...)
# SPACE_DEPLOYER=0x...

# Space controller at creation. Defaults to SPACE_DEPLOYER; only set this if the
# creating wallet and the initial controller genuinely differ.
# SPACE_CONTROLLER_INITIAL=0x...

# Space controller after the handover (doc: "then replace with").
SPACE_CONTROLLER=0x3ea731dAF66D6A7980549f90152CD9A761B9c0C0

# saltNonce for the space proxy (chosen by the snapshot.box frontend in production).
SPACE_SALT_NONCE=1

# saltNonce for the execution-strategy proxy. The strategy is always deployed in the
# same snapshot.box "Create" flow as the space, signed by SPACE_DEPLOYER.
STRATEGY_SALT_NONCE=1

# Doc: voting delay 2D 0H 0M, min and max voting duration 3D 0H 0M.
# Converted at 12s per block: 2d = 14400, 3d = 21600.
VOTING_DELAY=14400
MIN_VOTING_DURATION=21600
MAX_VOTING_DURATION=21600

# Doc quorum: 30,000,000 SHU (18 dp) on the Avatar execution strategy.
# snapshot.box stores this as float64(30M * 1e18); the harness's quorum check
# tolerates that sub-ULP rounding, so you do not need the exact on-chain value here.
QUORUM=30000000000000000000000000

# 10,000,000 SHU — proposition-power threshold to open a proposal.
PROPOSAL_THRESHOLD=10000000000000000000000000

# The doc specifies no metadataURI / daoURI, and the snapshot.box UI leaves daoURI
# empty unless you fill the ERC-4824 field. Both default to empty (Step 2 only checks
# daoURI). Set these only if your deployment sets them.
# SPACE_METADATA_URI=
# SPACE_DAO_URI=
